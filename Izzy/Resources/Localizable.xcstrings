{
  "sourceLanguage": "en",
  "strings": {
    "Izzy does not require an account and has no advertising or analytics SDKs. The developer does not receive your notes or progress.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Izzyはアカウント登録が不要で、広告やアクセス解析のSDKも使用していません。メモや学習記録が開発者に送られることはありません。"
          }
        }
      }
    },
    "Updated 16 September 2026": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新日：2026年9月16日"
          }
        }
      }
    },
    "Phrase font": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズのフォント"
          }
        }
      }
    },
    "Used for phrases on Home, in Phrases and in reviews.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム、フレーズ一覧、復習でのフレーズ表示に使います。"
          }
        }
      }
    },
    "Mountains and Ocean are free. Every background opens with Izzy Pro.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山と海は無料です。すべての背景はIzzy Proで使えます。"
          }
        }
      }
    },
    "New York and SF Pro are free. Every font opens with Izzy Pro.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "New YorkとSF Proは無料です。すべてのフォントはIzzy Proで使えます。"
