      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」の背景"
          }
        }
      }
    },
    "Try again": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試す"
          }
        }
      }
    },
    "Trying to produce a reply gives you a retrieval opportunity. Reading an example and recognizing it is a different task.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で返答を考えることが、記憶から言葉を取り出す練習になります。例文を読んで意味がわかることとは、異なる練習です。"
          }
        }
      }
    },
