    },
    "Privacy policy": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーポリシー"
          }
        }
      }
    },
    "Proficient": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熟達"
          }
        }
      }
    },
    "Progress, saved phrases, and personal notes are stored in the app's local storage. Your device backup settings may include this data. Deleting the app removes its local data; restoring a device backup may restore it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習記録、保存した表現、メモはアプリ内に保存されます。端末の設定によっては、バックアップに含まれることがあります。アプリを削除すると端末内のデータも削除されますが、端末のバックアップから復元される場合があります。"
          }
        }
      }
    },
    "Purchased": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入済み"
          }
        }
