    "Translate sentence": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例文を翻訳"
          }
        }
      }
    },
    "Translate this sentence into Japanese. The first use may ask to download English and Japanese language data; after downloading, translation works on your device.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この例文を日本語に訳します。初回は英語と日本語の言語データのダウンロードを求められる場合があります。ダウンロード後は端末内で翻訳できます。"
          }
        }
      }
    },
    "Translating…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳中…"
          }
        }
      }
    },
    "Translation couldn't finish. Check that language downloads are allowed and there is enough free space, then try again. You can still read the expression's meaning below.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳を完了できませんでした。言語データをダウンロードできることと、空き容量を確認して、もう一度お試しください。表現の意味は下で確認できます。"
          }
        }
      }
    },
    "Try again": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試す"
