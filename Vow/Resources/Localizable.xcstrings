    "Meaning & examples": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味と例文"
          }
        }
      }
    },
    "Notifies you at the first chosen time after a review is due, at most once a day. Turning this off cancels scheduled reminders.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習が必要になった後、最初に迎える指定時刻に1日1回まで通知します。オフにすると予約済みの通知も取り消されます。"
          }
        }
      }
    },
    "New expressions per day, phrasal verbs and idioms together. Reviews are added on top.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日に新しく学ぶ表現の数です。句動詞とイディオム共通で、復習は別枠で加わります。"
          }
        }
      }
    },
    "Only standard English voices are installed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、英語の音声は標準品質のみです。"
          }
        }
      }
    },
