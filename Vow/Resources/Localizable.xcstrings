    },
    "Audio is unavailable right now. The example is available as text.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、音声を再生できません。例文は文字で確認できます。"
          }
        }
      }
    },
    "Audio is unavailable right now. Try playing again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is unavailable right now. Try playing again."
