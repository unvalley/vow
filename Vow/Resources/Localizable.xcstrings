    },
    "Recording couldn't start. Try again, or use a typed reply.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開始できませんでした。もう一度試すか、文字で回答してください。"
          }
        }
      }
    },
    "Recording is optional. You can speak without recording or type a reply. Microphone access can be changed in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は任意です。録音せずに話したり、文字で回答したりすることもできます。マイクの使用許可はiOSの設定で変更できます。"
          }
        }
      }
    },
    "Recording ready": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音済み"
          }
        }
      }
    },
    "Recording was interrupted. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が中断されました。もう一度お試しください。"
          }
        }
      }
    },
    "Recordings are temporary files on your device. They are removed when you leave an exercise; abandoned files are removed on the next launch. You can practice without microphone access.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は端末内に一時ファイルとして保存され、練習を終えると削除されます。残ったファイルは次回の起動時に削除されます。マイクの使用を許可しなくても練習できます。"
          }
        }
      }
    },
    "Recordings stay on this device and are deleted when you leave an exercise. Your progress, saved phrases and notes are stored locally.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音はこの端末内に保存され、練習を終えると削除されます。学習の進み具合、保存した表現、メモも端末内に保存されます。"
          }
        }
      }
    },
    "Reminder time": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知する時刻"
          }
        }
      }
    },
    "Reminders couldn't be scheduled. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を予約できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "Repeat playlist": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat playlist"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返し再生"
          }
        }
      }
    },
    "Restore purchases": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元"
          }
        }
      }
    },
    "Retelling gives you another chance to find language for a familiar message. The 60/45/30-second practice adapts the idea of 4/3/2 speaking tasks; the shorter version has not been independently validated.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ内容を話し直すと、伝えたいことに合う言葉をもう一度探せます。60秒・45秒・30秒の練習は、4分・3分・2分で話す練習をもとにしています。この短縮版そのものの効果は、独立した研究では検証されていません。"
          }
        }
      }
    },
    "Retrieve before you reveal": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えを見る前に思い出す"
          }
        }
      }
    },
    "Review reminders": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習のリマインダー"
          }
        }
      }
    },
    "Review reminders are optional. After you allow notifications, review dates and your chosen time are used to schedule notifications on this device. No learning history is sent to the developer. Turn reminders off in Settings to cancel scheduled notifications.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習のリマインダーは任意です。通知を許可すると、復習の予定と指定した時刻に基づき、この端末内で通知を予約します。学習履歴が開発者に送られることはありません。設定でリマインダーをオフにすると、予約済みの通知も取り消されます。"
          }
        }
      }
    },
    "Review the meaning": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味を復習する"
          }
        }
      }
    },
    "Reviews are spaced using your own recall ratings. The spacing principle has research support; this app’s exact intervals are a simple design choice, not a validated optimum.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思い出せたかどうかの自己評価に合わせて、復習の間隔を調整します。間隔を空ける学習法には研究による裏づけがありますが、このアプリの具体的な間隔は設計上の選択であり、最適だと検証されたものではありません。"
          }
        }
      }
    },
    "Save daily goal": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習量を保存"
          }
        }
      }
    },
    "Saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み"
          }
        }
      }
    },
    "Say the same thing again": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ内容をもう一度話す"
          }
        }
      }
    },
    "Select the English sentence above and choose Translate from the menu. Choose Japanese as the translation language.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の英文を選択し、メニューの「翻訳」を押してください。翻訳先には日本語を選びます。"
          }
        }
      }
    },
    "Selected": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中"
          }
        }
      }
    },
    "Sentence meaning": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例文の意味"
          }
        }
      }
    },
    "Sentence translations are generated by Apple Translate. Use the expression's meaning and context to check idioms and phrasal verbs.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例文の訳にはAppleの翻訳を使います。慣用句や句動詞は、表現の意味や文脈と照らし合わせて確認してください。"
          }
        }
      }
    },
    "Set daily goal": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習量を設定"
