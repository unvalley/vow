        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部の参考リンクを開くと、それぞれのウェブサイトに移動します。移動先では、そのサイトのプライバシーポリシーが適用されます。"
          }
        }
      }
    },
